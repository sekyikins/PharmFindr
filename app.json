{
  "expo": {
    "name": "PharmFindr",
    "slug": "PharmFindr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pharmfindr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mrsekyi.PharmFindr",
      "config": {
        "googleMapsApiKey": "AIzaSyAXy83HZpz5JTArZYZ8IZFfXDSjGiNzxd0"
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow PharmFindr to use Face ID for secure authentication.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAXy83HZpz5JTArZYZ8IZFfXDSjGiNzxd0"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mrsekyi.PharmFindr"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#BFDBFE"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PharmFindr needs your location to find nearby pharmacies."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PharmFindr needs camera access to scan prescription documents."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PharmFindr to use Face ID for secure authentication."
        }
      ],
      "expo-notifications",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6ea880a-486a-42e1-8be7-ca44af58f58d"
      }
    },
    "owner": "mrsekyi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e6ea880a-486a-42e1-8be7-ca44af58f58d"
    }
  }
}
